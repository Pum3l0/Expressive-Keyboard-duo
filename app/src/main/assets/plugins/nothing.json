{
  "id": "builtin.nothing",
  "name": "Nothing",
  "version": "1.0",
  "author": "Expressive Keyboard",
  "description": "В стиле Nothing Phone: монохром, буквы из точек как на точечной матрице, контуры из точек, точечная сетка на фоне и красный Enter. Тёмная и светлая версия.",
  "icon": "⚪",
  "skin": {
    "keyboard": {
      "background": { "pattern": "dots", "colors": ["#EFEFEF", "#CDCDCD"], "cell": 9 },
      "trail": "#D71921",
      "corner": 26
    },
    "colors": {
      "background": "#EFEFEF", "key": "#FFFFFF", "keyText": "#000000",
      "func": "#E3E3E3", "funcText": "#000000", "accent": "#D71921", "accentText": "#FFFFFF"
    },
    "keys": {
      "*": {
        "material": "solid",
        "background": "#FFFFFF",
        "pressedBackground": "#000000",
        "text": "#000000",
        "pressedText": "#FFFFFF",
        "border": "#9A9A9A",
        "borderWidth": 1.3,
        "borderStyle": "dots",
        "labelEffect": "dots",
        "fontWeight": 800,
        "fontScale": 1.12,
        "radius": 14,
        "pressedRadius": 18,
        "press": "scale",
        "pressScale": 0.95,
        "inset": 1,
        "hideHint": true
      },
      "func": { "background": "#E3E3E3", "border": "#8A8A8A" },
      "enter": {
        "background": "#D71921", "pressedBackground": "#FF3B30", "text": "#FFFFFF",
        "borderWidth": 0, "labelEffect": "none"
      },
      "space": { "fontScale": 1.0 }
    },
    "popup": { "radius": 14, "background": "#000000", "text": "#FFFFFF", "pressedBackground": "#D71921", "pressedText": "#FFFFFF" },
    "chips": { "material": "none", "text": "#000000" },
    "buttons": { "material": "outline", "background": "#FFFFFF", "border": "#9A9A9A", "borderWidth": 1.2, "borderStyle": "dots", "text": "#000000" },
    "panel": { "material": "outline", "background": "#F7F7F7", "border": "#B5B5B5", "borderWidth": 1.2, "borderStyle": "dots", "radius": 22 },
    "dark": {
      "keyboard": { "background": { "pattern": "dots", "colors": ["#000000", "#262626"], "cell": 9 } },
      "colors": {
        "background": "#000000", "key": "#121212", "keyText": "#FFFFFF",
        "func": "#1D1D1D", "funcText": "#FFFFFF", "accent": "#D71921", "accentText": "#FFFFFF"
      },
      "keys": {
        "*": { "background": "#121212", "pressedBackground": "#FFFFFF", "text": "#FFFFFF", "pressedText": "#000000", "border": "#4A4A4A" },
        "func": { "background": "#1D1D1D", "border": "#5A5A5A" },
        "enter": { "background": "#D71921", "pressedBackground": "#FF3B30", "text": "#FFFFFF" }
      },
      "popup": { "background": "#FFFFFF", "text": "#000000" },
      "chips": { "text": "#FFFFFF" },
      "buttons": { "background": "#0A0A0A", "border": "#4A4A4A", "text": "#FFFFFF" },
      "panel": { "background": "#0A0A0A", "border": "#3A3A3A" }
    },
    "options": [
      {
        "id": "dotLabels", "title": "Буквы из точек", "type": "toggle", "default": true,
        "off": { "keys": { "*": { "labelEffect": "none", "fontWeight": 600, "fontScale": 1.0 } } }
      },
      {
        "id": "dotBorders", "title": "Контуры из точек", "type": "toggle", "default": true,
        "off": { "keys": { "*": { "borderStyle": "solid", "borderWidth": 0.8 } } }
      },
      {
        "id": "redEnter", "title": "Красный Enter", "type": "toggle", "default": true,
        "off": {
          "keys": { "enter": { "background": "#E3E3E3", "pressedBackground": "#000000", "text": "#000000", "borderWidth": 1.3, "labelEffect": "dots" } },
          "dark": { "keys": { "enter": { "background": "#1D1D1D", "pressedBackground": "#FFFFFF", "text": "#FFFFFF" } } }
        }
      },
      {
        "id": "grid", "title": "Фон", "type": "choice", "default": "dots",
        "choices": [
          { "id": "dots", "title": "Точечная сетка" },
          { "id": "plain", "title": "Однотонный", "patch": { "keyboard": { "background": "#EFEFEF" }, "dark": { "keyboard": { "background": "#000000" } } } }
        ]
      }
    ]
  }
}
